{
  "name": "@gnosys/matsci-search-periodic-kit",
  "version": "0.0.8",
  "description": "Extracted search bar and periodic table component library from matsci-ui",
  "author": "hyacinth",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./searchbar": {
      "import": "./dist/searchbar.js",
      "types": "./dist/searchbar.d.ts"
    },
    "./periodic-table": {
      "import": "./dist/periodic-table.js",
      "types": "./dist/periodic-table.d.ts"
    },
    "./tooltip": {
      "import": "./dist/tooltip.js",
      "types": "./dist/tooltip.d.ts"
    },
    "./composite": {
      "import": "./dist/composite.js",
      "types": "./dist/composite.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/primitives.css": "./dist/styles/primitives.css",
    "./styles/searchbar.css": "./dist/styles/searchbar.css",
    "./styles/periodic-table.css": "./dist/styles/periodic-table.css",
    "./styles/composite.css": "./dist/styles/composite.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://packages.aliyun.com/6549daf63aaed849b035d118/npm/gnosys-release/"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && rollup -c && node scripts/prepare-style-assets.mjs",
    "build-storybook": "storybook build --disable-telemetry",
    "check": "npm run typecheck && npm run test && npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs release",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:changelog": "node scripts/release.mjs changelog",
    "release:pack": "npm pack --dry-run --cache ./.npm-cache",
    "storybook": "storybook dev -p 6007 --disable-telemetry --no-open",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-swc": "^0.3.1",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.0",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
